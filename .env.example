# =============================================================================
#  WA Scheduler — Environment Configuration Template
#  Copy this file to .env.dev and fill in your actual values.
#  Never commit real secrets.
# =============================================================================

# ── Application ───────────────────────────────────────────────
APP_NAME=WA Scheduler Backend
APP_ENV=dev
DEBUG=True

# ── Database ──────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://user:[your password]@localhost:5432/wa_scheduler

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=your-strong-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# ── WhatsApp ──────────────────────────────────────────────────
WA_PROFILE_DIR=C:/wa_chrome_profile
WA_HEADLESS=True

# ── Scheduler ─────────────────────────────────────────────────
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_TIMEZONE=Asia/Kolkata
