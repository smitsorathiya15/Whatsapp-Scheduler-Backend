# ── Application ───────────────────────────────────────────
APP_NAME=WA Scheduler Backend
APP_ENV=production
DEBUG=False

# ── Database (PostgreSQL) ─────────────────────────────────
# Use your cloud PostgreSQL connection string (Supabase, Neon, Railway, etc.)
DB_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# ── WhatsApp (not used on Vercel — serverless) ────────────
# WA_PROFILE_DIR=/tmp/wa_profile
# WA_HEADLESS=True

# ── Scheduler (not used on Vercel — serverless) ──────────
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_TIMEZONE=Asia/Kolkata
